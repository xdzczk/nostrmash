# Copy to .env and adjust for local runs (docker-compose sets these inline; use this for go run).

DATABASE_URL=postgres://nostrmash:nostrmash@localhost:5432/nostrmash?sslmode=disable
# Optional explicit DB URL for integration tests. If unset, tests fall back to DATABASE_URL.
TEST_DATABASE_URL=postgres://nostrmash:nostrmash@localhost:5432/nostrmash?sslmode=disable

# API only
HTTP_ADDR=:8080
API_MAX_BATCH_SIZE=200
ADMIN_BEARER_TOKEN=change-me
PRIMAL_WS_MAX_SUBSCRIPTIONS=200
PRIMAL_WS_REQUEST_TIMEOUT=10s
PRIMAL_WS_MAX_MESSAGE_BYTES=1048576
PRIMAL_WS_MAX_REQ_PER_MINUTE=240
PRIMAL_WS_ALLOWED_ORIGINS=http://localhost:3000
PRIMAL_WS_ALLOW_ANY_ORIGIN=false
MEILI_ENABLED=false
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=nostrmash-dev-key
# Optional search-only API key. Falls back to MEILI_MASTER_KEY when omitted.
MEILI_SEARCH_API_KEY=

LOG_LEVEL=info
ENVIRONMENT=development
APP_VERSION=dev

# Ingestor relay lifecycle + live subscriptions (Chunk 6: live only)
INGESTOR_RELAY_URLS=wss://relay.primal.net,wss://relay.damus.io,wss://nos.lol
INGESTOR_RELAY_ALLOWLIST=wss://relay.primal.net,wss://relay.damus.io,wss://nos.lol
INGESTOR_RELAY_DISABLED=
INGESTOR_RELAY_REQUIRE_TLS=false
INGESTOR_RELAY_CONNECT_TIMEOUT=10s
INGESTOR_RELAY_BACKOFF_INITIAL=1s
INGESTOR_RELAY_BACKOFF_MAX=30s
INGESTOR_RELAY_LAG_THRESHOLD=45s
INGESTOR_FILTER_GROUP=default_v1
INGESTOR_LIVE_BOOTSTRAP_LOOKBACK_SECONDS=300
INGESTOR_LIVE_RESUME_OVERLAP_SECONDS=60
# Optional override; JSON object of named groups, each with {"kinds":[...]}.
# INGESTOR_FILTER_GROUPS_JSON={"default_v1":{"kinds":[0,1,3,4,5,6,7,9735,9802,10000,10002,10003,30023]}}

# Optional bootstrap/backfill before live mode (Chunk 7)
INGESTOR_BACKFILL_ENABLED=false
INGESTOR_BACKFILL_MODE=backfill
# Unix seconds; blank means unbounded
INGESTOR_BACKFILL_SINCE=
INGESTOR_BACKFILL_UNTIL=
INGESTOR_BACKFILL_PAGE_LIMIT=500
INGESTOR_BACKFILL_CONNECT_TIMEOUT=10s
INGESTOR_BACKFILL_IDLE_TIMEOUT=3s
INGESTOR_BACKFILL_EMPTY_PAGE_MAX=2

# Deterministic replay mode (Task 15)
# INGESTOR_MODE=live uses relay manager + optional backfill.
# INGESTOR_MODE=replay replays fixture payloads and exits.
INGESTOR_MODE=live
INGESTOR_REPLAY_FIXTURE_PATH=internal/replay/testdata/relay_payloads/basic_flow.ndjson

# Optional bounded language enrichment for note discovery/search.
NOSTRMASH_LANGUAGE_DETECTION_ENABLED=true
NOSTRMASH_LANGUAGE_DETECTION_MIN_CHARS=20
NOSTRMASH_LANGUAGE_DETECTION_MIN_CONFIDENCE=0.60

# --- Trust graph (shared; loaded by api, ingestor, worker, trust_worker) ---
# Comma-separated hex pubkeys — WoT roots. Required before INGESTOR_TRUST_GATE_MODE=trusted_only.
# TRUST_SEED_PUBKEYS=
TRUST_MAX_HOPS=3

# --- Trust worker (seed reconcile, snapshot refresh, global trust runs) ---
TRUST_GRAPH_SNAPSHOT_REFRESH_INTERVAL=10m
TRUST_RUN_INTERVAL=1h
TRUST_ENABLE_SCORE_COMPUTE=true
TRUST_ENABLE_REDIS_SYNC=false
# TRUST_REDIS_URL=redis://localhost:6379/0
# TRUST_REDIS_KEY_PREFIX=nostrmash
TRUST_WORKER_CONCURRENCY=2
TRUST_WORKER_CLAIM_BATCH_SIZE=5

# --- Ingestor trust-bounded gate (storage bounding) ---
# open = shadow (metrics only); trusted_only = enforce kind-1 author + 6/7/9735 target-exists
INGESTOR_TRUST_GATE_MODE=open
INGESTOR_TRUST_GATE_MAX_HOPS=2
INGESTOR_TRUST_GATE_REFRESH_INTERVAL=2m

# --- Worker engagement raw retention (kinds 6/7/9735; lifetime counters survive) ---
WORKER_RETENTION_ENGAGEMENT_ENABLED=true
WORKER_RETENTION_ENGAGEMENT_MAX_AGE=336h
WORKER_RETENTION_ENGAGEMENT_DEAD_GRACE=168h
WORKER_RETENTION_ENGAGEMENT_RUN_INTERVAL=1h
WORKER_RETENTION_ENGAGEMENT_DELETE_BATCH_LIMIT=2000

# --- Worker superseded replaceable retention (kinds 0/3/10002; latest version kept) ---
WORKER_RETENTION_REPLACEABLE_ENABLED=true
WORKER_RETENTION_REPLACEABLE_MIN_AGE=24h
WORKER_RETENTION_REPLACEABLE_DEAD_GRACE=168h
WORKER_RETENTION_REPLACEABLE_RUN_INTERVAL=1h
WORKER_RETENTION_REPLACEABLE_DELETE_BATCH_LIMIT=2000

# --- Worker processed deletion retention (kind 5; tombstone ledger kept) ---
WORKER_RETENTION_DELETION_ENABLED=true
WORKER_RETENTION_DELETION_MAX_AGE=336h
WORKER_RETENTION_DELETION_DEAD_GRACE=168h
WORKER_RETENTION_DELETION_RUN_INTERVAL=1h
WORKER_RETENTION_DELETION_DELETE_BATCH_LIMIT=2000

# --- Worker / metrics (when running binaries outside docker-compose) ---
# METRICS_ADDR=:9090
# WORKER_CONCURRENCY=4
